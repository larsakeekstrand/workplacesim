[Unit]
Description=workplacesim office display
Documentation=https://github.com/laek/workplacesim
# Wait for an IP before starting. We tried dropping this to save ~20-30s of
# Pi 1 wifi-association on cold boot, but the in-binary mdns-sd responder
# doesn't re-publish the host A-record when interfaces come up after the
# service has started — so `workplacesim.local` stops resolving for hook
# POSTs. The boot-time speedup needs a different approach (either fix the
# responder to react to interface-up events, or restart workplacesim once
# wifi associates).
After=network-online.target
Wants=network-online.target
# Steal tty1 from the login prompt so our process owns the framebuffer and
# console; getty would otherwise redraw over our scene and grab VT ioctls.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/bin/workplacesim
Environment=HOST=0.0.0.0
Environment=PORT=4317
Environment=RUST_LOG=info
Environment=HOSTNAME=%H
Restart=always
RestartSec=2
User=root
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
